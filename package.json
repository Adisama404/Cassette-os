{
  "name": "cassette.os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The high-fidelity desktop experience for Cassette.OS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build:web": "vite build",
    "build:desktop": "npm run build:web && electron-builder",
    "preview": "vite preview",
    "desktop": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "package": "cross-env ELECTRON_BUILDER_CACHE=./.builder_cache npm run build && electron-builder build --publish never"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.cassette.os",
    "productName": "Cassette OS",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false
  }
}
